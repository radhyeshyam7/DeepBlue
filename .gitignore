# --- 1. Dependencies ---
# We don't push these because they are huge. 
# Others can download them using 'npm install'.
node_modules/
jspm_packages/

# --- 2. Environment / Secrets ---
# Never push passwords, API keys, or database URLs!
.env
.env.local
.env.sample
.env.production
backend/.env
frontend/.env

# --- 3. Build Output ---
# Generated files from build process
dist/
build/
frontend/dist/
backend/dist/
.vercel

# --- 4. System Files ---
# Files created by your computer (Mac or Windows) automatically.
.DS_Store
Thumbs.db
desktop.ini

git reset


# --- 5. Editor / IDE Files ---
# Settings specific to your VS Code or other editors.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# --- 6. Logs ---
# Error reports that are only useful on your machine.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- 7. Testing ---
coverage/
.nyc_output/

# --- 8. Temporary Files ---
*.tmp
*.temp
.cache/

# --- 9. Python & MLOps ---
venv/
venv_mlops/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
mlruns/
mlops/mlruns/
mlops/mlflow.db
mlops/data/raw/*.csv
mlops/data/processed/*.csv
mlops/data/features/*.csv
!mlops/data/raw/.gitkeep
!mlops/data/processed/.gitkeep
!mlops/data/features/.gitkeep

monitoring/grafana-*/
monitoring/prometheus-*/
monitoring/prometheus-data/
monitoring/*.zip
monitoring/*.tar.gz