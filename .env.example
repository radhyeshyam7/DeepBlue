# ==============================================================================
# DeepBlue4 / Saarthi AI - Environment Configuration Template
# 100% Free & Open-Source MLOps Architecture
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Backend (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Application Database (MongoDB Community)
MONGODB_URI=mongodb://localhost:27017/DEEP_BLUE

# Application Cache & Velocity Store (Redis Community)
REDIS_URL=redis://localhost:6379

# Optional SMS / Twilio (Gracefully skipped if false)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# FastAPI ML Inference Service Integration
# ------------------------------------------------------------------------------
FASTAPI_ML_URL=http://localhost:8001
FASTAPI_PORT=8001
FASTAPI_HOST=0.0.0.0
FASTAPI_WORKERS=1

# ------------------------------------------------------------------------------
# MLflow Experiment Tracking & Local Model Registry
# ------------------------------------------------------------------------------
# Database-backed tracking server using SQLite + local filesystem artifacts
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///mlops/mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlops/mlruns
MODEL_NAME=FraudDetectionModel
MODEL_STAGE=Production
MODEL_VERSION=1

# ------------------------------------------------------------------------------
# Monitoring & Observability (Prometheus & Grafana OSS)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# Airflow Workflow Automation (Optional Docker Compose Profile)
# ------------------------------------------------------------------------------
# PostgreSQL database is ONLY for Airflow internal metadata, NOT application data
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow_metadata
AIRFLOW_UID=50000
