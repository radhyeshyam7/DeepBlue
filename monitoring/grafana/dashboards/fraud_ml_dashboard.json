{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Real-Time UPI Fraud ML Metrics Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Predictions",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(ml_prediction_total) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "High Risk Predictions",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(ml_high_risk_prediction_total) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Avg Inference Latency (ms)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "avg(rate(ml_prediction_latency_seconds_sum[1m]) / rate(ml_prediction_latency_seconds_count[1m])) * 1000 or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Model Info",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "ml_model_info",
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "name"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Anomaly Score Distribution & Drift Monitoring",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Recent Anomaly Score Stream",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "ml_model_prediction_score",
          "legendFormat": "Anomaly Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 6,
      "title": "Population Stability Index (PSI) Drift Score",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "ml_model_drift_score",
          "legendFormat": "Mean PSI",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Data Quality & Reliability",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Missing Features Count",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "sum(ml_feature_missing_total) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API Errors & Fallbacks",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "sum(rate(ml_prediction_errors_total[5m])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["mlops", "fraud", "deepblue4"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "title": "Saarthi AI - Fraud ML Monitoring Dashboard",
  "version": 1
}
